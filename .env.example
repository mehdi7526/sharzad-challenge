# Both modes use real HTTP. mock starts the local GET-only backend.
HOME_DATA_SOURCE=mock
API_BASE_URL=http://127.0.0.1:4000
MOCK_PORT=4000
# Homepage: normal, slow, error, empty.
MOCK_HOME_SCENARIO=normal
# Viewer: normal (signed out), slow, error, signed-in (demo account).
MOCK_VIEWER_SCENARIO=normal
