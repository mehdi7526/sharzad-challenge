# One backend address shared by server and browser; public and fixed at build time.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
# Start the backend alongside Next.js; false when it already runs separately.
START_BACKEND=true
BACKEND_PORT=4000
# Open http://localhost:3000 for direct browser requests with this allowed origin.
BACKEND_CORS_ORIGIN=http://localhost:3000
# Homepage: normal, slow, error, empty.
BACKEND_HOME_SCENARIO=normal
# Viewer: normal, slow, error, signed-in.
BACKEND_VIEWER_SCENARIO=normal
