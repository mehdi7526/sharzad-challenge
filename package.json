{
  "name": "shahrzad-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src docs scripts tests backend *.mjs *.mts *.ts *.json README.md *.yml",
    "format:check": "prettier --check src docs scripts tests backend *.mjs *.mts *.ts *.json README.md *.yml",
    "build:webpack": "next build --webpack",
    "test:e2e": "playwright test tests/home.spec.ts tests/viewer.spec.ts && MOCK_HOME_SCENARIO=empty playwright test tests/home-states.spec.ts && MOCK_HOME_SCENARIO=error playwright test tests/home-states.spec.ts",
    "mock": "node --experimental-strip-types backend/mock/server.mts",
    "dev:frontend": "next dev --hostname 0.0.0.0",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.27.0",
    "axios": "^1.11.0",
    "iconsax-react": "^0.0.8",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "swr": "^2.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
